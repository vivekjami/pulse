# Local development only — `cp .env.example .env` per README "Running locally".
# On Zerops these arrive as OS env vars from zerops.yaml run.envVariables over the
# private network; never ship a .env to a container (an empty value there shadows
# the platform's real one).

# docker-compose.yml: postgres:16
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse

# docker-compose.yml: valkey:8
VALKEY_URL=redis://localhost:6379

# api — axum on :3000, SSE at /v1/live
PORT=3000

# ingest — the public firehose. No API key required.
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

RUST_LOG=info
